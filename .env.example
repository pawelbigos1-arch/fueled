# Skopiuj wartości do Vercel: Project → Settings → Environment Variables
# (Production + Preview; Development lokalnie w .env.local)

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Parsowanie posiłków (/api/parse-food, /api/parse-food-image) — tylko serwer; NIE ustawiaj NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Opcja: bez tego adres wraca z przeglądarki (production/preview automatycznie).
# Ustaw w Production na swoją stałą domenę prod, jeśli użyjesz np. fueled.app:
# NEXT_PUBLIC_SITE_URL=https://fueled-ten.vercel.app
#
# Supabase → Authentication → URL configuration:
#   Site URL: https://fueled-ten.vercel.app (lub Twoja niestandardowa domena)
#   Redirect URLs — minimum produkcja:
#     https://fueled-ten.vercel.app/auth/callback
#   Opcjonalnie preview Vercel (dopisz wzorce zgodnie z dokumentacją Supabase, np.):
#     https://fueled*-*.vercel.app/auth/callback
#     https://fueled-ten-git-*-*.vercel.app/auth/callback
